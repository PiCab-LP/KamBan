{
    "compilerOptions": {
        "target": "ES2020",
        "jsx": "react-jsx",
        "allowJs": true,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": ["src"]
}